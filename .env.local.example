# =============================================================
# IMPORTANTE PARA EL DESPLIEGUE
# Las tres primeras son necesarias EN TIEMPO DE BUILD, no solo en
# runtime: la portada (/) se prerenderiza durante `next build` y
# consulta el catálogo de formaciones. Si faltan al compilar, la
# portada se publica vacía.
# =============================================================

# Supabase (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (REQUIRED for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Cron secret (REQUIRED for the daily phrase notification)
# Set the same value in Vercel env vars; Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>" to /api/cron/daily-phrase.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Stripe (REQUIRED for payments)
# ─────────────────────────────────────────────────────────────────────────
#
# ⚠️  LAS CUATRO VARIABLES DE STRIPE TIENEN QUE SER DEL MISMO MODO  ⚠️
#
# Stripe mantiene dos mundos separados —prueba y real— y los objetos de uno
# no existen en el otro. Si mezclas (por ejemplo `sk_live_` con un
# `price_` creado en modo prueba), el pago falla al recuperar la sesión:
# la clave real busca en el mundo real un objeto que solo existe en el de
# prueba, y no lo encuentra.
#
# En modo prueba la clave empieza por `sk_test_` y los `price_...` y el
# `whsec_...` salen del panel con el interruptor de modo prueba activado.
# Al pasar a real hay que cambiar las CUATRO a la vez, no solo la clave.
#
# Tarjeta para probar: 4242 4242 4242 4242, fecha futura, CVC cualquiera.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Precio del PAGO ÚNICO (337,97 €) → acceso permanente.
# Debe ser un precio "one-time" en Stripe, NO recurrente.
STRIPE_PRICE_ID_LIFETIME=price_...

# Precio de la SUSCRIPCIÓN (67 €/mes) → añade talleres y mentoría 1 a 1
# incluida. Debe ser un precio RECURRENTE MENSUAL en Stripe: si lo creas con
# otra periodicidad, el cliente lee «al mes» y se le cobra otra cosa.
STRIPE_PRICE_ID_MEMBERSHIP=price_...

# Nombre antiguo, de cuando solo había un producto. Se sigue aceptando como
# respaldo de STRIPE_PRICE_ID_LIFETIME para no romper entornos existentes.
STRIPE_PRICE_ID=price_...

# Cloudflare Stream (OPTIONAL - for video uploads)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=

# Carta natal externa (OPCIONAL)
# Si no se define, el código cae en una URL por defecto incrustada.
NEXT_PUBLIC_CARTA_NATAL_URL=

# Base de la API (OPCIONAL)
# Vacío = mismo origen. Solo se toca si la API vive en otro dominio.
NEXT_PUBLIC_API_URL=

# Groq (REQUIRED for AI assistant - get free key at console.groq.com)
# Free tier: 14,400 req/day, 30 req/min — much more reliable than OpenRouter free models.
GROQ_API_KEY=gsk_...
# Optional: pin a specific Groq model. Leave empty to use the automatic fallback list.
# Options: llama-3.3-70b-versatile | deepseek-r1-distill-llama-70b | gemma2-9b-it | llama-3.1-8b-instant
GROQ_MODEL=

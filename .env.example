# ==========================================
# SUPABASE CONFIGURATION
# En producción, estas variables se configuran en el panel de tu hosting (Vercel / Netlify / etc.)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL
NEXT_PUBLIC_APP_URL=https://plataformaainara.com

# Cron secret
CRON_SECRET=your-cron-secret

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Google Gemini AI (Tutor en tiempo real con contexto de formaciones y lecciones)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq AI (Fallback opcional)
GROQ_API_KEY=
GROQ_MODEL=

# Vercel: configure at least one provider key in each environment that runs the app
# (Production/Preview/Development as appropriate), then redeploy. Model names are optional.
# AI history also requires migrations/scripts creating ai_conversations and ai_messages.

# Migraciones del panel admin (solo entorno local/CI; nunca NEXT_PUBLIC)
# DATABASE_URL=postgresql://usuario:password@host:5432/postgres
# DATABASE_SSL_CA=/ruta/local/certificado-raiz-supabase.crt
